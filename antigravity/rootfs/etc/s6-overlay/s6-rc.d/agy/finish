#!/usr/bin/env bash
# Called when the agy service exits. s6 restarts it; add a short back-off so a
# crash loop doesn't hammer the Antigravity backend.
exit_code="${1:-0}"
if [[ "${exit_code}" -ne 0 && "${exit_code}" -ne 256 ]]; then
    echo "[agy] service exited with code ${exit_code}; restarting in 10s" >&2
    sleep 10
fi
