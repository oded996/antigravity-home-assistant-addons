#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# EXPERIMENTAL: local Antigravity web UI ("hub" mode of the CLI).
#
# Hub mode is undocumented and gated behind AGY_ENABLE_HUB. The server only
# binds to 127.0.0.1; nginx publishes it on :8765 behind basic auth (see
# init-antigravity) and/or serves it in the ingress panel. Idles when neither
# local_web_ui nor ingress_panel=web_ui is enabled.
# ==============================================================================
source /usr/local/lib/antigravity/env.sh
set +o errexit +o nounset +o pipefail

if [[ "${AGY_HUB_ENABLED:-false}" != "true" ]]; then
    exec sleep infinity
fi

cd "${AGY_WORKSPACE}" || exit 1
LOG="${AGY_STATE_DIR}/hub.log"
: >"${LOG}"

bashio::log.info "Starting experimental local web UI (agy hub on 127.0.0.1:18765) ..."
export AGY_ENABLE_HUB=true
"${AGY_BIN}" --hub --hub-port 18765 </dev/null >>"${LOG}" 2>&1 &
pid=$!

# Surface the first lines of output in the add-on log.
for _ in $(seq 1 30); do
    sleep 1
    if grep -q -i -E "running|error|sign in|not signed" "${LOG}" 2>/dev/null; then
        break
    fi
    kill -0 "${pid}" 2>/dev/null || break
done
sed -e 's/\x1b\[[0-9;]*[A-Za-z]//g' "${LOG}" | grep -v '^[[:space:]]*$' | head -n 10 | while IFS= read -r l; do
    bashio::log.info "hub: ${l}"
done

wait "${pid}"
rc=$?
bashio::log.warning "Local web UI exited (code ${rc}); last output:"
sed -e 's/\x1b\[[0-9;]*[A-Za-z]//g' "${LOG}" | grep -v '^[[:space:]]*$' | tail -n 5 | while IFS= read -r l; do
    bashio::log.warning "hub: ${l}"
done
sleep 30
exit 1
